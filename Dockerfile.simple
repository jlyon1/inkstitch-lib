# Simple API-only Dockerfile - NO inkex, NO wxPython, NO PyGObject
FROM python:3.12-slim

# Essential build tools + dependencies for inkex/PyGObject
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    pkg-config \
    libcairo2 \
    libcairo2-dev \
    libgirepository1.0-dev \
    gir1.2-glib-2.0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy application files
COPY batch_text_to_pes.py gunicorn_config.py ./
COPY lib ./lib
COPY fonts ./fonts

# Install Python dependencies in stages
# Stage 1: Core dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    gunicorn \
    lxml \
    pystitch \
    numpy

# Stage 2: Dependencies that need compilation
RUN pip install --no-cache-dir \
    pycairo \
    pillow

# Stage 3: inkex (requires PyGObject which needs special handling)
RUN pip install --no-cache-dir \
    'git+https://gitlab.com/inkscape/extensions.git@EXTENSIONS_AT_INKSCAPE_1.4.1'

EXPOSE 8000

ENV PYTHONUNBUFFERED=1

CMD ["gunicorn", "-w", "2", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8000", "batch_text_to_pes:app"]
