# Working Dockerfile - copies inkex from local instead of pip installing
FROM python:3.12-slim

# Essential build tools (no PyGObject dev packages needed!)
RUN apt-get update && apt-get install -y \
    gcc \
    pkg-config \
    libcairo2 \
    libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy application files
COPY batch_text_to_pes.py gunicorn_config.py ./
COPY lib ./lib
COPY fonts ./fonts

# Copy inkex from local venv (avoids PyGObject compilation hell)
COPY .venv/lib/python3.12/site-packages/inkex /usr/local/lib/python3.12/site-packages/inkex

# Install Python dependencies (NO inkex via pip!)
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    gunicorn \
    lxml \
    pystitch \
    numpy \
    pycairo \
    pillow

EXPOSE 8000

ENV PYTHONUNBUFFERED=1

CMD ["gunicorn", "-w", "2", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8000", "batch_text_to_pes:app"]
